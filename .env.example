# Stellar Network
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SECRET_KEY=

# Contracts - Testnet
ESCROW_CONTRACT_ID_TESTNET=
DISPUTE_RESOLUTION_CONTRACT_ID_TESTNET=

# Contracts - Public Network
ESCROW_CONTRACT_ID_PUBLIC=
DISPUTE_RESOLUTION_CONTRACT_ID_PUBLIC=

# Backend
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/arbitra
REDIS_URL=redis://localhost:6379

# API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Auth (issue #29) — required in production, dev-only fallback otherwise
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=arbitra-ai-agent

# Rate limiting (requests per window) — defaults shown
RATE_LIMIT_CHAT_POINTS=5
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_READ_POINTS=100
RATE_LIMIT_READ_WINDOW_SECONDS=60
RATE_LIMIT_MUTATE_POINTS=15
RATE_LIMIT_MUTATE_WINDOW_SECONDS=60
# LLM Config
LLM_PROVIDER=anthropic # or openai
LLM_MODEL=claude-3-5-sonnet-latest
