# Stellar Network
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SECRET_KEY=

# Contracts - Testnet
ESCROW_CONTRACT_ID_TESTNET=
DISPUTE_RESOLUTION_CONTRACT_ID_TESTNET=

# Contracts - Public Network
ESCROW_CONTRACT_ID_PUBLIC=
DISPUTE_RESOLUTION_CONTRACT_ID_PUBLIC=

# Backend
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/arbitra
REDIS_URL=redis://localhost:6379

# API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM Config
LLM_PROVIDER=anthropic # or openai
LLM_MODEL=claude-3-5-sonnet-latest
