{
  "name": "arbitra-ai-agent",
  "version": "0.1.0",
  "description": "AI agent for Arbitra on-chain arbitration and escrow protocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "generate:escrow-bindings": "stellar contract bindings typescript --output-dir src/blockchain/generated"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "@stellar/stellar-sdk": "^11.3.0",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
